# ──────────────────────────────────────────────────────────────────────────────
# gestion-uq — Variables de entorno
# Copiar a .env.local (frontend) y backend/.env (backend)
# ¡NUNCA subir los valores reales a control de versiones!
# ──────────────────────────────────────────────────────────────────────────────

# ── FRONTEND (.env.local) ─────────────────────────────────────────────────────

# URL del backend Express en desarrollo
VITE_API_URL=http://localhost:3001

# Clave secreta compartida entre frontend y backend para /api/v1/upload-pdf
# Debe tener mínimo 32 caracteres — generar con: openssl rand -hex 32
VITE_API_SECRET=CAMBIA_ESTO_POR_UN_SECRET_LARGO_DE_AL_MENOS_32_CHARS

# ── BACKEND (backend/.env) ────────────────────────────────────────────────────
# Debe coincidir exactamente con VITE_API_SECRET
API_SECRET=CAMBIA_ESTO_POR_UN_SECRET_LARGO_DE_AL_MENOS_32_CHARS

# Puerto del servidor Express
PORT=3001

# Entorno: development | production
NODE_ENV=development

# CORS: dominios autorizados separados por coma (dejar vacío para dev = todo permitido)
# Ejemplo producción: https://gestion-uq.vercel.app,https://productividad.uniquindio.edu.co
CORS_ORIGIN=

# ── GOOGLE DRIVE (backend/.env) ───────────────────────────────────────────────
# Cuenta de servicio con acceso a Google Drive
GOOGLE_DRIVE_CLIENT_EMAIL=nombre@proyecto.iam.gserviceaccount.com

# Clave privada RSA de la cuenta de servicio (con saltos de línea como \n)
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXXXXXX\n-----END RSA PRIVATE KEY-----"

# ID de la carpeta de Google Drive donde se subirán los archivos
GOOGLE_DRIVE_FOLDER_ID=1ABC_XXXXXXXXXXXXXXXXXXXXX

# (Opcional) Dominio universitario para restringir acceso a archivos Drive
# Ejemplo: uniquindio.edu.co — si se omite, los archivos serán accesibles para cualquiera
DRIVE_DOMAIN=uniquindio.edu.co
